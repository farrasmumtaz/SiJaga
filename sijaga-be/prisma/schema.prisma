generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  status   String? @default("PENDING")
  card_id  String  @unique

  @@map("users")
}

model UsageHistory {
  id        Int      @id @default(autoincrement())
  Timestamp DateTime @default(now())
  name      String
  status    String
  card_id   String

  @@map("usage_history")
}

model CardIdDumps {
  id         Int       @id @default(autoincrement())
  card_id    String
  createdAt  DateTime  @default(now()) @map("created_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([createdAt(sort: Desc)])
  @@index([card_id, createdAt(sort: Desc)])
  @@map("card_id_dumps")
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())

  @@map("blacklisted_tokens")
}

model LockedStatus {
  id        Int      @id @default(autoincrement())
  status    String
  Timestamp DateTime @default(now())

  @@index([Timestamp(sort: Desc), id(sort: Desc)])
  @@map("locked_status")
}
