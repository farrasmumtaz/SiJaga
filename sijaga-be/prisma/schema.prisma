generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  role     UserRole       @default(USER)
  history  UsageHistory[]
  id       Int            @id @default(autoincrement())
  name     String
  email    String         @unique
  password String
  status   String?        @default("PENDING")
  card_id  String         @unique

  @@map("users")
}

model UsageHistory {
  availStatus String? @map("avail_status")
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  id        Int      @id @default(autoincrement())
  Timestamp DateTime @default(now())
  name      String
  status    String
  card_id   String

  @@index([userId, Timestamp(sort: Desc), id(sort: Desc)])
  @@map("usage_history")
}

enum UserRole {
  USER
  ADMIN
}

model CardIdDumps {
  id         Int       @id @default(autoincrement())
  card_id    String
  createdAt  DateTime  @default(now()) @map("created_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([createdAt(sort: Desc)])
  @@index([card_id, createdAt(sort: Desc)])
  @@map("card_id_dumps")
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())

  @@map("blacklisted_tokens")
}

model LockedStatus {
  id        Int      @id @default(autoincrement())
  status    String
  Timestamp DateTime @default(now())

  @@index([Timestamp(sort: Desc), id(sort: Desc)])
  @@map("locked_status")
}

model BoxStatus {
  id         Int      @id @default(autoincrement())
  status     String
  distanceCm Int?     @map("distance_cm")
  Timestamp  DateTime @default(now())

  @@index([Timestamp(sort: Desc), id(sort: Desc)])
  @@map("box_status")
}
